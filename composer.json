{
    "name": "opoink/oliv",
    "description": "Opoink Laravel Inertia Vue",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Opoink\\Oliv\\": "src/"
        },
        "files": ["functions.php"]
    },
    "authors": [
        {
            "name": "Ron",
            "email": "ron@opoink.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.31|^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/sanctum": "^4.0",
        "phpmailer/phpmailer": "^6.9.2",
        "gumlet/php-image-resize": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Opoink\\Oliv\\Providers\\AppServiceProvider"
            ],
            "aliases": {}
        }
    }
}
